# Batch files need CRLF endings - LF breaks label jumps, and the
# updater runs them in the OEM codepage (ascii-only guard in tests)
*.bat text eol=crlf

# Shell scripts need LF endings - CRLF breaks shebangs on Linux
*.sh text eol=lf

# Developer-only content stays out of the release zip (git archive).
# Verified: no runtime code, installer or updater reads these paths.
/tests/ export-ignore
/deploy/release_checks.bat export-ignore
/RELEASE_NOTES_1.3.9.md export-ignore
/_relnotes_131_final.md export-ignore
/docs/roadmap_1.4.md export-ignore
/docs/plan_1.4_voice.md export-ignore

# SHIPPING-TRIM (2026-10-18): a user release needs the program, the launchers and
# the user docs - not the engineering audits, the release-note drafts (they are
# the GitHub release body, uploaded from the repo) or the dev pre-commit hook.
/docs/audit_*.md export-ignore
/RELEASE_NOTES_*.md export-ignore
/scripts/ export-ignore
/ruff.toml export-ignore
/.gitignore export-ignore
/.gitattributes export-ignore
