# Batch files need CRLF endings - LF breaks label jumps, and the
# updater runs them in the OEM codepage (ascii-only guard in tests)
*.bat text eol=crlf

# Shell scripts need LF endings - CRLF breaks shebangs on Linux
*.sh text eol=lf

# Developer-only content stays out of the release zip (git archive).
# Verified: no runtime code, installer or updater reads these paths.
# (update.bat reads deploy\render_release_notes.ps1 and
# deploy\update_prune.ps1 - those must keep shipping; 2026-11-04 audit
# added the two dev-gate scripts that slipped through unexcluded.)
/tests/ export-ignore
/deploy/release_checks.bat export-ignore
/deploy/prepush_check.ps1 export-ignore
/deploy/promote_main.bat export-ignore
/docs/roadmap_1.4.md export-ignore
/docs/plan_1.4_voice.md export-ignore

# SHIPPING-TRIM (2026-10-18): a user release needs the program, the launchers and
# the user docs - not the engineering audits, the release-note drafts (they are
# the GitHub release body, uploaded from the repo) or the dev pre-commit hook.
/docs/audit/ export-ignore
/docs/architecture.md export-ignore
/RELEASE_NOTES_*.md export-ignore
/scripts/ export-ignore
/ruff.toml export-ignore
/.gitignore export-ignore
/.gitattributes export-ignore

# Coverage tooling (2026-11-07): dev-only measurement setup for the standalone
# suites; the generated .coverage* data files are gitignored. The tests/ entries
# are already covered by /tests/ above - listed explicitly for self-documentation.
/.coveragerc export-ignore
/tests/coverage_site/** export-ignore
/tests/coverage_run.py export-ignore
/requirements-dev.txt export-ignore
