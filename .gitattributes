# Normalize line endings: code stays LF in the repo (also on Windows),
# Windows batch scripts keep CRLF (required by cmd.exe).

* text=auto

*.py   text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.jinja text eol=lf
*.sh   text eol=lf
*.service text eol=lf
*.bat  text eol=crlf
*.cmd  text eol=crlf
