[Unit]
Description=HiveMind AI Coding Assistant
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=hivemind
Group=hivemind
WorkingDirectory=/opt/hivemind
ExecStart=/opt/hivemind/.venv/bin/python run.py
Restart=on-failure
RestartSec=10
TimeoutStopSec=30

Environment=PYTHONUNBUFFERED=1

# VOICE (1.4): the TTS sidecar runs `uvx pocket-tts serve` as THIS user, so uv
# needs a writable HOME/cache and the gated model needs a Hugging Face home.
# Without HOME, uv cannot decide where its cache lives and the first speech
# request fails; without HF_HOME the model lands in an unpredictable place.
Environment=HOME=/opt/hivemind
Environment=UV_CACHE_DIR=/opt/hivemind/.cache/uv
Environment=HF_HOME=/opt/hivemind/.cache/huggingface
# The Pocket TTS model is gated. A nologin system user cannot run
# `hf auth login`, so put the token here (or in a drop-in) if you want TTS:
#Environment=HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxx

# Backend: vulkan | cuda | cpu (default: vulkan). For CPU-only hosts uncomment:
#Environment=HIVEMIND_GPU_BACKEND=cpu

MemoryMax=12G
TasksMax=64

StandardOutput=append:/var/log/hivemind/hivemind.log
StandardError=append:/var/log/hivemind/hivemind.log

[Install]
WantedBy=multi-user.target
