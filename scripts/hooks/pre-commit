#!/bin/sh
# F821 (undefined names) + F811 (redefinition) + F841 (unused locals) —
# introduced after e14f64f left a dangling _split_discard_note reference that
# made every write_file_append report FAILED after the disk write had
# succeeded (model retried → duplicated content). F841 catches the inverse:
# a lost call site leaves the callee unused. ruff catches that class
# statically at commit time.
RUFF=""
for _c in "./.venv/Scripts/ruff.exe" "./.venv/Scripts/ruff" "ruff"; do
    if command -v "$_c" >/dev/null 2>&1; then RUFF="$_c"; break; fi
done
# MODULE FALLBACK (2026-10-04): ruff exists as a module on this machine but
# NOT on PATH - the hook then silently skipped EVERY commit and two
# red-suite commits slipped through. Never skip silently again.
if [ -z "$RUFF" ]; then
    if python -m ruff --version >/dev/null 2>&1; then
        RUFF="python -m ruff"
    else
        echo "pre-commit: ruff NOT FOUND (binary or module) - BLOCKING commit" >&2
        exit 1
    fi
fi

FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$')
[ -z "$FILES" ] && exit 0

# shellcheck disable=SC2086
# (unquoted $RUFF on purpose: "python -m ruff" must word-split)
$RUFF check --select F821,F811,F841 --no-cache $FILES || exit 1

# fast test suites (<3s) — the success-path net; skipped when the
# tooling deps are absent, but never skipped silently on FAILURE
PY="./.venv/Scripts/python.exe"
if [ -f "$PY" ]; then
    for T in tests/test_write_tools.py tests/test_truncation_flow_fake.py \
             tests/test_coder_env_line.py tests/test_approval_timeout.py \
             tests/test_preset_housekeeping.py; do
        [ -f "$T" ] || continue
        "$PY" "$T" >/dev/null 2>&1 || {
            echo "pre-commit: $T FAILED — run it for details"
            exit 1
        }
    done
fi
exit 0
