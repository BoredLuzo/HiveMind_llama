# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Logs
*.log
logs/

# Lint / test caches
.ruff_cache/
.pytest_cache/

# Model junk
*.incomplete
*.lock

# Environment
.env
.venv/
venv/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Runtime state — changes every run, do not commit
runtime_models.json
token_stats.json
run_counter.json

# App config is runtime state: install.bat generates settings.json from
# settings.py defaults, presets.json is written on every preset save.
settings.json
presets.json

# SearXNG runtime config: searxng.bat install rewrites docker-compose.yml +
# settings.yml (per-machine secret + host port). Templates ship as *.example.
searxng-config/docker-compose.yml
searxng-config/settings.yml

# Generated by the installer/scanner (absolute paths to the local models folder)
models.json

# Session data
sessions/*.json
infra/sessions/

# Large data — loaded via install.bat/setup_models.bat, NOT part of the repo
/llama/
/models/
# Per-model base configs (model_configs/models/) ARE part of the repo — keep them.
!/model_configs/models/

# App runtime data (Learning/Memory/Chat contexts)
learning_logs/
learning/sessions/
model_configs/learning_logs/
model_configs/learned/
context/projects/
context/last_workspace.json
custom_prompts/
memory.json
soul.json

# Explicit backend log coverage (belt + suspenders)
backend/*.log

# Local tooling & backups (not part of the release)
.opencode/
.zcode/
backups/

# Learned routing weights (generated at runtime)
routing_weights.json

# ruff.toml is TRACKED since 2026-10-05: worktrees and other agents need
# the same lint config, otherwise ruff runs with defaults and reports ~2400
# phantom hits (the gateway worktree lint failure).
requirements-dev.txt
docs/tools-audit.md
docs/structure-backlog.md
deploy/analyze_cache_log.py
deploy/ab_phase1.ps1
clean_release.bat

# Dev-only helpers & agent notes (kept locally, not pushed)
AGENTS.md
tools/sync_to_installs.py
deploy/backup_data.py
deploy/gen_settings_docs.py
deploy/hivemind_windows.py

# local smoke/bench artifacts (settings backups, SSE dumps) — never pushed
bench_results/

# BUILD_INFO.txt (2026-10-04): generated at packaging time (git describe)
# and embedded into the release zip - never tracked.
BUILD_INFO.txt

# local test suites (fat dev tooling — never shipped with releases;
# the pre-commit hook still runs them when present locally)
# tests are tracked again (2026-10-03): the persistence/format suites are
# the verification for every future schema change; runtime artifacts inside
# tests/ stay ignored via the global rules above.

_runc*/, previews
_edit*.txt
_steer_*.txt
_steer_img.b64
_tg*.txt
_tgprobe_cid.txt
_tgstart.txt
_ui_img.b64

# ── Telegram gateway (WP1) ────────────────────────────────────────────────
# The REAL gateway.toml lives next to start_gateway.bat in the live dir and
# must never be tracked, zipped or updated over. State/audit/kill-switch
# live in %LOCALAPPDATA%\HiveMindGateway (outside every workspace) — listed
# here as belt-and-suspenders, enforced by update.bat /XF and the
# package_release.bat leak check.
gateway.toml
gateway_audit.jsonl
gateway_audit.jsonl.*
gateway_state.json
gateway_state.json.corrupt
gateway.disabled
gateway.lock
gateway.pid

# internal audit docs - never in a release zip
docs/gateway_audit_glm_full.md
model_configs/gguf_filename_tags.json

# internal gateway docs (owner-only, not for the public tree)
docs/gateway_audit_installer_ui.md
docs/gateway_brief.md
docs/gateway_contract.md
docs/gateway_realrun_wp2.md
docs/gateway_security_audit.md
docs/gateway_security_audit_deep.md
docs/gateway_status.md
docs/plan_1.3.4.md
docs/wp3_proposals.md
